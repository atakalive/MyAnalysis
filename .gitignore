data/

# Dataset registry (Issue #95) — user's registration data, never tracked.
# 2 行目は .lock / mkstemp の *.tmp / 退避の .bak / .corrupt をまとめて除外する。
/datasets.local.json
/datasets.local.json.*

# LLM backend config (copy from config.example.toml)
llm_backend/config.toml
llm_backend/config.toml.lock

# LLM backend per-backend model settings (copy from models.example.toml)
/models.toml
/models.toml.lock

# pi runtime artifacts — track only the committed skill
/.pi/*
!/.pi/skills/
!/.pi/skills/**

# Claude Code のローカル設定・作業状態（PC ローカル）
/.claude/

# 壊れた TOML の退避（llm_backend/settings_store.py）と、config_share が .env.pulled を書くときのロック（Issue #102）
*.toml.bak
/.env.pulled.lock
