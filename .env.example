# Ollama (local) — recommended for development
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=llama3.2:1b
# OPENAI_API_KEY is not required for Ollama.

# OpenAI cloud (alternative) — uncomment and replace
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Notes:
# - "export" prefix is accepted (e.g. "export OPENAI_MODEL=...").
# - Inline comments are NOT supported. "KEY=value # comment" sets
#   the value to "value # comment", not "value".
# - Shell environment variables take precedence over this file.

# Mock backend (LLM不要 — GUI/ストリーミングのスモーク確認用)
# 時刻・天気・占いはモック値、原油価格のみ stooq.com から実取得する。
# OPENAI_MODEL は任意。表示名としてのみ使われる。
# OPENAI_BASE_URL=mock
# OPENAI_MODEL=mock-omni
