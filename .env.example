# Ollama (local) — recommended for development
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=llama3.2:1b
# OPENAI_API_KEY is not required for Ollama.

# OpenAI cloud (alternative) — uncomment and replace
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Notes:
# - "export" prefix is accepted (e.g. "export OPENAI_MODEL=...").
# - Inline comments are NOT supported. "KEY=value # comment" sets
#   the value to "value # comment", not "value".
# - Shell environment variables take precedence over this file.

# Mock backend (LLM不要 — GUI/ストリーミングのスモーク確認用)
# 時刻・天気・占いはモック値、原油価格のみ stooq.com から実取得する。
# OPENAI_MODEL は任意。表示名としてのみ使われる。
# OPENAI_BASE_URL=mock
# OPENAI_MODEL=mock-omni

# ---- backend 選択 ----
# backend は llm_backend/config.toml で選ぶ(config.example.toml を参照)。
# LLM_BACKEND を立てると config.toml より優先される: "pi" | "openai" | "mock"。
# LLM_BACKEND=pi

# ---- pi (pi-coding-agent) backend ----
# 導入: npm i -g @earendil-works/pi-coding-agent
#   (旧名 @mariozechner/pi-coding-agent は deprecated。0.73.1 で更新停止)
# 設定(cwd/bin/model/provider/tools)は llm_backend/config.toml に書く。
# PI_API_KEY は secret なのでここ(.env)に置く。未設定なら pi の login/env に委ねる。
# PI_API_KEY=
#
# Windows: pi はツール実行に bash を必要とする(Git Bash 推奨)。
#   bash が無いと pi の対話自体は動くが skill 経由の `python -m llm_bridge` 等が失敗する。
#   bash の場所は ~/.pi/agent/settings.json の shellPath 指定、または PATH 上の
#   bash.exe (Git Bash / Cygwin / MSYS2 / WSL) で解決される。

# ---- Cloudflare R2 で config を同期（任意・best-effort） ----
# 使うなら: pip install boto3
# R2 でバケット作成 → API トークン発行 → endpoint/鍵を控える。バケットは必ず private。
# 未設定なら同期機能が無効になるだけで、ローカル登録簿 JSON (datasets.local.json) が
# そのまま使われる。
# R2_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# R2_BUCKET=myanalysis-config
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PREFIX=config/          # 任意（既定 config/。末尾スラッシュは自動補完）
# R2_AUTOSYNC=0              # 自動同期だけ止める（手動 config-* は残る）
# R2_DEBUG=1                 # 自動経路の skip 理由を stderr に出す

# ---- ミーティング共有リレー（Issue #42 / #44・任意） ----
# View → ミーティング共有… で相手をチャットドックへライブ参加させる。
# 構成: ローカル・インメモリ・リレー（既定は loopback 127.0.0.1）+ 公開トンネルで外部公開（$0・KV/R2 不使用）。
# LAN リンク ON 時のみ、同一リレーを 0.0.0.0 にもバインドし LAN 直結の第2リンクを出す（Issue #85）。
# 必要なもの:
#   1) RELAY_ADMIN_KEY を「非空」で設定（ローカルリレーの admin 認証に使う任意の秘密文字列）。
#   2) 公開トンネル（cloudflared）: Cloudflare named tunnel。自分の Cloudflare 委譲ドメインで
#      固定 HTTPS URL を発行（$0・URL 不変・到達性良好）。要ワンタイム設定（詳細は
#      relay-worker/README.md）: cloudflared 導入 → `tunnel login` → `tunnel create <name>`
#      → `tunnel route dns <name> <hostname>`。設定後は CLOUDFLARE_TUNNEL_NAME と
#      CLOUDFLARE_TUNNEL_HOSTNAME を必ず設定する（未設定だと共有開始時に tunnel_failed、
#      詳細は共有ウィンドウのログに出る）。
# 未設定（RELAY_ADMIN_KEY 空）なら共有機能が無効になるだけ（GUI の他機能には影響しない）。
# RELAY_ADMIN_KEY=<任意の秘密文字列。例: `openssl rand -base64 32`>
# -- cloudflared 用 --
# CLOUDFLARE_TUNNEL_NAME=myanalysis-relay              # tunnel create の名前（別PCでは UUID 推奨）
# CLOUDFLARE_TUNNEL_HOSTNAME=relay.example.com   # tunnel route dns した固定ホスト名
# CLOUDFLARED_BIN=cloudflared.exe                      # cloudflared が PATH に無いときだけ（フルパス）
# CLOUDFLARE_TUNNEL_CRED=C:\Users\<you>\.cloudflared\<UUID>.json  # 任意。別PCで login を省くとき
#
# -- LAN 直結リンク（Issue #85・任意） --
# 組織ネットワークの DNS がトンネルのホスト名を解決できない環境向けに、ホスト PC へ LAN 直結する第2リンクを併発できる。
# 共有ダイアログの「LAN リンクも出す」を ON にすると有効（既定 OFF）。CLI は `meeting-start lan=true`。
# RELAY_LAN_HOST=192.168.1.50   # LAN URL のホスト初期値／CLI 単独 LAN 起動時のホスト供給源（既定は未設定＝loopback のみ）
# RELAY_LAN_PORT=8787           # 固定ポート要求（bare integer 必須）。衝突時は ephemeral に落とさず OSError＝起動失敗。未設定/非整数は ephemeral

# -- 同期マウントへの書込戦略（Issue #96・通常は変更不要） --
# rclone/WinFsp マウント上では rename-into-place が約22%の確率でサイレントに失敗して
# ファイルが 0 バイトになるため、fragile FS では in-place write に切り替えている。
# 判定は GetVolumeInformationW の FS 名（rclone は "FUSE-rclone" を返す）。
# MYANALYSIS_WRITE_STRATEGY=auto     # auto(既定) / replace(#96 以前の挙動) / inplace
# MYANALYSIS_FS_OVERRIDE=M:=fragile,D:=local   # FS 判定の明示上書き（最長プレフィックス一致）
# MYANALYSIS_FORCE_FRAGILE=1         # 全パスを fragile 扱い（デバッグ用）
# PYTHONPYCACHEPREFIX=...            # 未設定なら run.bat / 各バックエンドが data/pycache を設定
